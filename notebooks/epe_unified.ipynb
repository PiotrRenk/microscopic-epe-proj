    "import tableone\n",
    "\n",
    "df_copy = df.copy()\n",
    "# Convert binary columns to bool\n",
    "bool_cols = ['MRI EPE', 'MRI EPE L', 'MRI EPE P', 'MRI SVI', 'MRI SVI L', 'MRI SVI P']\n",
    "for col in bool_cols:\n",
    "    df_copy[col] = df_copy[col].astype(bool)\n",
    "\n",
    "# rename = {\n",
    "#     'wiek': 'Age',\n",
    "#     'PSA': 'PSA',\n",
    "#     'PSAdensity': 'PSA Density',\n",
    "#     'MRI vol': 'MRI Volume',\n",
    "#     'MRI SIZE': 'MRI Size',\n",
    "# }\n",
    "table1 = tableone.TableOne(\n",
    "    df_copy, \n",
    "    columns=numerical_cols + categorical_cols, \n",
    "    categorical=categorical_cols, \n",
    "    continuous=numerical_cols, \n",
    "    nonnormal=numerical_cols,\n",
    "    groupby='EPE RP', \n",
    "    # rename=rename,\n",
    "    pval=True\n",
    ")\n",
    "print(table1.tabulate(tablefmt=\"fancy_grid\"))\n",
    "table1.to_excel('population.xlsx')"
   ]
