    "    'classifier__max_depth': [3, 6, 9],\n",
    "    'classifier__subsample': [0.8, 0.9, 1.0],\n",
    "    'classifier__colsample_bytree': [0.8, 0.9, 1.0],\n",
    "    'classifier__gamma': [0, 0.1, 0.2]\n",
    "}\n",
    "\n",
    "model = XGBClassifier(random_state=2)\n",
    "#brier score and tuning test split = 0.2\n",
    "res = train_and_evaluate_model(model, X, y, numerical_cols, categorical_cols, n_folds=5, tune_params=True, param_grid=param_grid, tuning_scoring='roc_auc', tuning_test_size=0.2)\n",
    "untrained_model = model.set_params(**res.best_params)\n",
    "\n",
    "plot_roc(res.fp_rate, res.tp_rate, res.roc_auc, fig_width=800)\n",
    "plot_confusion_matrix(res.y_true, res.y_pred)\n",
    "plot_feature_importance(res.pipeline, X, y, title='Feature Importance for micro EPE Prediction')\n",
    "plot_discrimination_threshold(untrained_model, X, y)"
   ]
  },
